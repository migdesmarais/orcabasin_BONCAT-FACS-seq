# A) predict genes (CDS) on each MAG

mkdir -p /scratch/mdesmarais/OB_BONCAT-FACS-SEQ/active_mags_b20_insitu/ref/cds

screen
conda activate prodigal

for fa in *.fna; do
  base=$(basename "$fa" .fna)
  prodigal -i "$fa" \
           -a "ref/cds/${base}.faa" \
           -d "ref/cds/${base}.fna" \
           -p meta -q
done

