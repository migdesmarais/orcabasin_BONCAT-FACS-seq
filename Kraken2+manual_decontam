#!/usr/bin/env bash
set -euo pipefail

########## USER SETTINGS ##########
SAMPLE=OB161
R1=/scratch/mdesmarais/OB_BONCAT-FACS-SEQ/reads/OB161_S45_L003_paired_R1.fastq.gz
R2=${R1/_R1/_R2}
IDX=/scratch/mdesmarais/OB_BONCAT-FACS-SEQ/decontam_reads/refs/build/contaminants_idx
THREADS=12
# Local mode is key for partial contaminant hits:
BOWTIE2_PRESET="--very-sensitive-local"
###################################

# Paths
BASE=/scratch/mdesmarais/OB_BONCAT-FACS-SEQ/decontam_reads
MAPDIR=${BASE}/maps_obnc
CLEANDIR=${BASE}/clean_reads
LOGDIR=${BASE}/logs
mkdir -p "$MAPDIR" "$CLEANDIR" "$LOGDIR"

echo "[*] SAMPLE      : $SAMPLE"
echo "[*] R1          : $R1"
echo "[*] R2          : $R2"
echo "[*] INDEX       : $IDX"
echo "[*] THREADS     : $THREADS"
echo "[*] B2 PRESET   : $BOWTIE2_PRESET"

# 1) Map (keep UNMAPPED in SAM; do NOT use --no-unal)
SAM=${MAPDIR}/${SAMPLE}_vs_CONTAM.sam
bowtie2 $BOWTIE2_PRESET -p "$THREADS" -x "$IDX" -1 "$R1" -2 "$R2" -S "$SAM" \
  2> ${LOGDIR}/${SAMPLE}.bowtie2.log

# 2) Sort two ways (name sort for FASTQ export; coordinate sort for idxstats/IGV)
NS_BAM=${MAPDIR}/${SAMPLE}.namesort.bam
COORD_BAM=${MAPDIR}/${SAMPLE}.coordsort.bam
samtools sort -@ "$THREADS" -n   -O BAM -o "$NS_BAM"    "$SAM"
samtools sort -@ "$THREADS"       -O BAM -o "$COORD_BAM" "$SAM"
samtools index "$COORD_BAM"

# 3) Correctly build CLEAN (both unmapped) and CONTAM (= NOT both unmapped)
UNMAPPED_BOTH_BAM=${MAPDIR}/${SAMPLE}.both_unmapped.bam     # CLEAN
NOT_BOTH_UNMAPPED_BAM=${MAPDIR}/${SAMPLE}.not_both_unmapped.bam  # CONTAM (≥1 mate mapped, incl. both mapped)
samtools view -@ "$THREADS" -b -f 12 -U "$NOT_BOTH_UNMAPPED_BAM" "$NS_BAM" > "$UNMAPPED_BOTH_BAM"

# 4) Export paired FASTQs (exclude secondary/supplementary with -F 0x900)
# CLEAN
samtools fastq -@ "$THREADS" -N -F 0x900 \
  -1 ${CLEANDIR}/${SAMPLE}_clean_R1.fastq.gz \
  -2 ${CLEANDIR}/${SAMPLE}_clean_R2.fastq.gz \
  -0 /dev/null -s /dev/null -n \
  "$UNMAPPED_BOTH_BAM"

# CONTAM
samtools fastq -@ "$THREADS" -N -F 0x900 \
  -1 ${CLEANDIR}/${SAMPLE}_contam_R1.fastq.gz \
  -2 ${CLEANDIR}/${SAMPLE}_contam_R2.fastq.gz \
  -0 /dev/null -s /dev/null -n \
  "$NOT_BOTH_UNMAPPED_BAM"

# 5) Summary
summary=${CLEANDIR}/decontamination_summary.tsv
[ -s "$summary" ] || echo -e "Sample\tTotal_Pairs\tClean_Pairs\tContam_Pairs\tPercent_Removed" > "$summary"
TOTAL=$(zcat "$R1" | awk 'END{print NR/4}')
CLEAN=$(zcat ${CLEANDIR}/${SAMPLE}_clean_R1.fastq.gz   | awk 'END{print NR/4}')
CONTAM=$(zcat ${CLEANDIR}/${SAMPLE}_contam_R1.fastq.gz | awk 'END{print NR/4}')
PCT=$(awk -v t="$TOTAL" -v r="$CONTAM" 'BEGIN{if(t>0) printf "%.3f",(r*100)/t; else print "NA"}')
echo -e "${SAMPLE}\t${TOTAL}\t${CLEAN}\t${CONTAM}\t${PCT}" >> "$summary"

# 6) PER-SOURCE COUNTS (same as yours)
PER_SRC=${MAPDIR}/${SAMPLE}.per_source_counts.tsv
if samtools idxstats "$COORD_BAM" | awk -F'\t' 'NR>1 && $1!="*"{if($1 ~ /\|/){print; exit}}' >/dev/null; then
  samtools idxstats "$COORD_BAM" \
  | awk -F'\t' '$1!="*"{split($1,a,"|"); src=a[1]; mapped=$3; if(mapped>0) c[src]+=mapped} END{for(s in c) printf "%s\t%d\n", s, c[s]}' \
  | sort -k2,2nr > "$PER_SRC"
else
  REFBASE=/scratch/mdesmarais/OB_BONCAT-FACS-SEQ/decontam_reads/refs
  TMPMAP=${MAPDIR}/${SAMPLE}.contig_to_source.tsv
  : > "$TMPMAP"
  for src in OBNC.contigs.fa UniVec_Core.fa phiX174.fa kitome.fa GRCh38.primary.fa; do
    [ -s "${REFBASE}/${src}" ] && awk -v S="$src" '/^>/{h=$0; sub(/^>/,"",h); split(h,a,/[\t ]/); print a[1]"\t"S}' "${REFBASE}/${src}" >> "$TMPMAP"
  done
  samtools idxstats "$COORD_BAM" | awk -F'\t' '$1!="*"{print $1"\t"$3}' | sort -k1,1 > ${MAPDIR}/${SAMPLE}.idxstats.tsv
  sort -k1,1 "$TMPMAP" > ${MAPDIR}/${SAMPLE}.contig_to_source.sorted.tsv
  join -t $'\t' -1 1 -2 1 ${MAPDIR}/${SAMPLE}.contig_to_source.sorted.tsv ${MAPDIR}/${SAMPLE}.idxstats.tsv \
  | awk -F'\t' '{by[$2]+=$3} END{for(k in by) print k"\t"by[k]}' \
  | sort -k2,2nr > "$PER_SRC"
fi

echo "[*] Done."
echo "[*] FASTQs: ${CLEANDIR}/${SAMPLE}_clean_R{1,2}.fastq.gz ; ${CLEANDIR}/${SAMPLE}_contam_R{1,2}.fastq.gz"
echo "[*] Summary: $summary"
echo "[*] Bowtie2 log: ${LOGDIR}/${SAMPLE}.bowtie2.log"
