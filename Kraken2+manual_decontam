#!/usr/bin/env bash
set -euo pipefail
conda activate bowtie2_env || true

REFDIR=$(pwd)               # current refs/ directory
cd "$REFDIR"
mkdir -p build

# Inputs (what you showed in the screenshot)
OBNC=OBNC.contigs.fa
PHIX=phiX174.fa
UNIVEC=UniVec_Core.fa
HUMAN=GRCh38.primary.fa
KITOME=kitome.fa

# If only the gz is present for human, make the .fa once
if [ ! -s "$HUMAN" ] && [ -s GRCh38.primary.fa.gz ]; then
  gunzip -c GRCh38.primary.fa.gz > GRCh38.primary.fa
fi

# Optional: include Illumina adapters if BBMap is installed
if command -v bbduk.sh >/dev/null 2>&1; then
  ADAPT_SRC="$(dirname "$(which bbduk.sh)")/resources/adapters.fa"
  [ -f "$ADAPT_SRC" ] && cp "$ADAPT_SRC" adapters.fa
fi

# Helper: tag headers with a prefix, but don't double-tag if already tagged
tag_fa () {
  src="$1"; prefix="$2"; dst="$3"
  awk -v pfx="$prefix" 'BEGIN{OFS=""}
    /^>/ { if ($0 ~ "^>" pfx "\\|") print $0; else print ">" pfx "|", substr($0,2); next }
         { print }' "$src" > "$dst"
}

# Tag each component
tag_fa "$OBNC"   "OBNC"    obnc.tag.fa
tag_fa "$PHIX"   "PHIX"    phix.tag.fa
tag_fa "$UNIVEC" "UNIVEC"  univec.tag.fa
tag_fa "$HUMAN"  "HUMAN"   human.tag.fa
tag_fa "$KITOME" "KITOME"  kitome.tag.fa
[ -f adapters.fa ] && tag_fa adapters.fa "ADAPTER" adapters.tag.fa || true

# Concatenate into one composite FASTA
cat obnc.tag.fa phix.tag.fa univec.tag.fa human.tag.fa \
    $( [ -f adapters.tag.fa ] && echo adapters.tag.fa ) \
    kitome.tag.fa > build/contaminants.fa

# Optional exact-duplicate removal (recommended if you have seqkit)
if command -v seqkit >/dev/null 2>&1; then
  seqkit rmdup -s -o build/contaminants_dedup.fa build/contaminants.fa
  REF_FASTA=build/contaminants_dedup.fa
else
  REF_FASTA=build/contaminants.fa
fi

#check that it ran ok
sum=0
for f in OBNC.contigs.fa UniVec_Core.fa phiX174.fa kitome.fa GRCh38.primary.fa; do
  c=$(grep -c '^>' "$f"); printf "%-20s %8d\n" "$f" "$c"; sum=$((sum+c))
done
printf "%-20s %8d\n" "SUM (inputs)" "$sum"
printf "%-20s %8d\n" "combined_contaminants.fa" "$(grep -c '^>' combined_contaminants.fa)"

# Build Bowtie2 index
bowtie2-build contaminants.fa contaminants_idx
bowtie2-inspect --summary ontaminants_idx
echo "[*] Done. Index prefix: $REFDIR/build/contaminants_idx"
